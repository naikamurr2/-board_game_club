<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BoardGameClub.ViewModels"
             xmlns:data="clr-namespace:BoardGameClub.Data;assembly=BoardGameClub.Data"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="BoardGameClub.Views.MainView"
             x:DataType="vm:MainViewModel">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<!-- Поля ввода, выпадающие списки, даты и галочки: не ниже 40 px -->
		<Style Selector="TextBox, ComboBox, CalendarDatePicker, CheckBox">
			<Setter Property="MinHeight" Value="40" />
		</Style>

		<!-- Кнопки действий: не ниже 40 px, на всю ширину формы -->
		<Style Selector="Button.act">
			<Setter Property="MinHeight" Value="40" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<!-- Заголовки вкладок: компактнее, чтобы все четыре помещались в ряд -->
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="MinHeight" Value="40" />
			<Setter Property="Padding" Value="10,0" />
		</Style>
	</UserControl.Styles>

	<TabControl>

		<!-- Экран 1: клиенты -->
		<TabItem Header="Клиенты">
			<ScrollViewer>
				<StackPanel Margin="8" Spacing="8">

					<StackPanel Spacing="4" MaxWidth="300" HorizontalAlignment="Left">
						<TextBlock Text="Имя и фамилия *" TextWrapping="Wrap" />
						<TextBox x:Name="ClientNameBox" />
						<TextBlock Text="Телефон" />
						<TextBox x:Name="ClientPhoneBox" />
						<TextBlock Text="Дата регистрации *" />
						<CalendarDatePicker x:Name="ClientDatePicker" HorizontalAlignment="Stretch" />
						<CheckBox x:Name="ClientCardCheck" Content="Есть клубная карта" />
						<Button Classes="act" Content="Добавить" Click="AddClient_Click" />
						<Button Classes="act" Content="Сохранить" Click="SaveClient_Click" />
						<Button Classes="act" Content="Удалить" Click="DeleteClient_Click" />
						<TextBlock x:Name="ClientsMessage" TextWrapping="Wrap" />
					</StackPanel>

					<TextBlock Text="Нажмите на запись, чтобы изменить или удалить её. Данные появятся в полях выше."
							   TextWrapping="Wrap" Opacity="0.7" />

					<ListBox x:Name="ClientsList" MaxHeight="250"
							 SelectionChanged="ClientsList_SelectionChanged">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="data:Client">
								<StackPanel Spacing="2" Margin="0,4">
									<TextBlock Text="{Binding FullName}" FontWeight="Bold" TextWrapping="Wrap" />
									<TextBlock Text="{Binding Phone, TargetNullValue='Телефон не указан'}"
											   TextWrapping="Wrap" />
									<TextBlock Text="{Binding RegistrationDate, StringFormat='В клубе с {0:dd.MM.yyyy}'}"
											   TextWrapping="Wrap" />
									<TextBlock Text="Есть клубная карта" IsVisible="{Binding HasClubCard}" />
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

				</StackPanel>
			</ScrollViewer>
		</TabItem>

		<!-- Экран 2: каталог игр -->
		<TabItem Header="Игры">
			<ScrollViewer>
				<StackPanel Margin="8" Spacing="8">

					<StackPanel Spacing="4" MaxWidth="300" HorizontalAlignment="Left">
						<TextBlock Text="Название *" />
						<TextBox x:Name="GameTitleBox" />
						<TextBlock Text="Минимум игроков *" />
						<TextBox x:Name="GameMinBox" />
						<TextBlock Text="Максимум игроков *" />
						<TextBox x:Name="GameMaxBox" />
						<TextBlock Text="Сложность (от 1 до 5) *" />
						<TextBox x:Name="GameComplexityBox" />
						<TextBlock Text="Цена за сутки, руб. *" />
						<TextBox x:Name="GamePriceBox" />
						<TextBlock Text="Описание" />
						<TextBox x:Name="GameDescriptionBox" TextWrapping="Wrap" />
						<Button Classes="act" Content="Добавить" Click="AddGame_Click" />
						<Button Classes="act" Content="Сохранить" Click="SaveGame_Click" />
						<Button Classes="act" Content="Удалить" Click="DeleteGame_Click" />
						<TextBlock x:Name="GamesMessage" TextWrapping="Wrap" />
					</StackPanel>

					<TextBlock Text="Нажмите на запись, чтобы изменить или удалить её. Данные появятся в полях выше."
							   TextWrapping="Wrap" Opacity="0.7" />

					<ListBox x:Name="GamesList" MaxHeight="250"
							 SelectionChanged="GamesList_SelectionChanged">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="data:Game">
								<StackPanel Spacing="2" Margin="0,4">
									<TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
									<StackPanel Orientation="Horizontal" Spacing="4">
										<TextBlock Text="Игроков:" />
										<TextBlock Text="{Binding MinPlayers}" />
										<TextBlock Text="–" />
										<TextBlock Text="{Binding MaxPlayers}" />
									</StackPanel>
									<TextBlock Text="{Binding Complexity, StringFormat='Сложность: {0} из 5'}"
											   TextWrapping="Wrap" />
									<TextBlock Text="{Binding PricePerDay, StringFormat='Цена: {0} руб./сутки'}"
											   TextWrapping="Wrap" />
									<TextBlock Text="{Binding Description, TargetNullValue='Описания нет'}"
											   TextWrapping="Wrap" />
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

				</StackPanel>
			</ScrollViewer>
		</TabItem>

		<!-- Экран 3: аренды -->
		<TabItem Header="Аренды">
			<ScrollViewer>
				<StackPanel Margin="8" Spacing="8">

					<StackPanel Spacing="4" MaxWidth="300" HorizontalAlignment="Left">
						<TextBlock Text="Клиент *" />
						<ComboBox x:Name="ClientCombo" HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="data:Client">
									<TextBlock Text="{Binding FullName}" TextWrapping="Wrap" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<TextBlock Text="Игра *" />
						<ComboBox x:Name="GameCombo" HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="data:Game">
									<TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<TextBlock Text="Дата выдачи *" />
						<CalendarDatePicker x:Name="RentalStartPicker" HorizontalAlignment="Stretch" />
						<TextBlock Text="Дата возврата (пусто, если игра ещё у клиента)" TextWrapping="Wrap" />
						<CalendarDatePicker x:Name="RentalReturnPicker" HorizontalAlignment="Stretch" />
						<TextBlock Text="Итоговая стоимость, руб. *" />
						<TextBox x:Name="RentalPriceBox" />
						<Button Classes="act" Content="Добавить" Click="AddRental_Click" />
						<Button Classes="act" Content="Удалить" Click="DeleteRental_Click" />
						<TextBlock x:Name="RentalsMessage" TextWrapping="Wrap" />
					</StackPanel>

					<TextBlock Text="Чтобы удалить аренду, нажмите на неё в списке, затем на кнопку «Удалить»."
							   TextWrapping="Wrap" Opacity="0.7" />

					<ListBox x:Name="RentalsList" MaxHeight="250">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="data:Rental">
								<TextBlock Text="{Binding .}" TextWrapping="Wrap" Margin="0,4" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

				</StackPanel>
			</ScrollViewer>
		</TabItem>

		<!-- Экран 4: игры, которые сейчас у клиентов -->
		<TabItem Header="На руках">
			<ListBox x:Name="ActiveRentalsList" Margin="8">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="data:Rental">
						<TextBlock Text="{Binding .}" TextWrapping="Wrap" Margin="0,4" />
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</TabItem>

	</TabControl>
</UserControl>